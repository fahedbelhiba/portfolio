.proj-points{list-style:none;margin-bottom:1.2rem;display:flex;flex-direction:column;gap:.42rem;}
.proj-points li{font-size:.8rem;color:var(--text-body);display:flex;align-items:flex-start;gap:.45rem;line-height:1.55;}
.proj-points li::before{content:"▹";color:var(--cyan);flex-shrink:0;}
