.skill-tags{display:flex;flex-wrap:wrap;gap:.45rem;}
.skill-tag{background:rgba(255,255,255,.05);border:1px solid var(--border);padding:.28rem .65rem;border-radius:6px;font-size:.78rem;font-family:var(--mono);color:var(--text-muted);font-weight:600;transition:all .2s;}
.skill-tag:hover{background:rgba(14,165,233,.1);border-color:rgba(14,165,233,.3);color:var(--cyan);}

