<script>
const body = document.body;
const langBtn = document.getElementById('langBtn') as HTMLButtonElement;
body.classList.add('lang-en');
langBtn?.addEventListener('click', () => {
  if (body.classList.contains('lang-en')) { body.classList.replace('lang-en','lang-fr'); langBtn.textContent='🌐 EN / FR'; }
  else { body.classList.replace('lang-fr','lang-en'); langBtn.textContent='🌐 FR / EN'; }
});
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = (btn as HTMLElement).dataset.filter!;
    document.querySelectorAll('.project-card').forEach(c => {
      const el = c as HTMLElement;
      el.style.display = (f==='all' || (el.dataset.category||'').includes(f)) ? '' : 'none';
    });
  });
});
const doorBtn = document.getElementById('doorBtn') as HTMLButtonElement;
let locked = true;
doorBtn?.addEventListener('click',()=>{ locked=!locked; doorBtn.textContent=locked?'LOCKED 🔒':'UNLOCKED 🔓'; addLog(locked?'[BLE] CMD: LOCK_DOORS → ACK':'[BLE] CMD: UNLOCK_DOORS → ACK',locked?'t-tx':'t-alert'); });
let temp=21.0;
document.getElementById('coolBtn')?.addEventListener('click',()=>{ temp=Math.max(16,temp-0.5); updateTemp(); });
document.getElementById('warmBtn')?.addEventListener('click',()=>{ temp=Math.min(30,temp+0.5); updateTemp(); });
function updateTemp(){ const tv=document.getElementById('targetVal'); const v=document.getElementById('tempVal'); if(tv)tv.textContent=temp.toFixed(1); if(v)v.textContent=temp.toFixed(0)+'°'; addLog(`[BLE] SET_HVAC=${temp.toFixed(1)}°C`,'t-tx'); }
document.getElementById('rssiSlider')?.addEventListener('input',e=>{ const val=(e.target as HTMLInputElement).value; const el=document.getElementById('rssiVal'); if(el)el.textContent=val+' dBm'; addLog(`[RSSI] ${val} dBm — ${parseInt(val)>-65?'Welcome Zone ACTIVE':'Out of range'}`,'t-rx'); });
function addLog(msg:string,cls:string){ const t=document.getElementById('terminal'); if(!t)return; const d=document.createElement('div'); d.className=cls; d.textContent=msg; t.appendChild(d); t.scrollTop=t.scrollHeight; }
setInterval(()=>{ const m=[{t:`[TELEMETRY] SoC: ${Math.floor(80+Math.random()*10)}% · Range: ${Math.floor(330+Math.random()*30)} km`,c:'t-rx'},{t:`[GATT] Cabin: ${(20+Math.random()*2).toFixed(1)}°C`,c:'t-rx'},{t:`[RSSI] Signal: ${Math.floor(-62+Math.random()*8)} dBm`,c:'t-tx'}]; const r=m[Math.floor(Math.random()*m.length)]; addLog(r.t,r.c); },4000);
</script>
