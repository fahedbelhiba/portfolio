.terminal{background:#080c14;border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:.8rem;font-family:var(--mono);font-size:.68rem;color:var(--text-dim);height:86px;overflow-y:auto;line-height:1.5;}
