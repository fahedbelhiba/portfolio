.award-points li::before{content:"★";color:#FBBF24;flex-shrink:0;font-size:.8rem;}

.timeline{position:relative;border-left:2px solid rgba(14,165,233,.2);margin-left:1rem;padding-left:2.25rem;display:flex;flex-direction:column;gap:2rem;}
.tl-node{position:relative;}
.tl-dot{position:absolute;left:-2.85rem;top:.35rem;width:15px;height:15px;border-radius:50%;background:var(--bg);border:3px solid var(--cyan);box-shadow:0 0 12px rgba(14,165,233,.5);}
.tl-dot.purple{border-color:var(--violet);box-shadow:0 0 12px rgba(124,58,237,.5);}
.tl-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;padding:1.7rem;transition:all .25s;}
.tl-card:hover{border-color:var(--border-cyan);}
.tl-header{display:flex;justify-content:space-between;flex-wrap:wrap;font-size:.75rem;font-family:var(--mono);color:var(--cyan);font-weight:700;margin-bottom:.3rem;}
.tl-role{font-size:1.12rem;font-weight:800;color:var(--text);margin-bottom:.2rem;}
.tl-org{font-size:.88rem;color:var(--text-muted);margin-bottom:.85rem;font-weight:600;}
.tl-points{list-style:none;display:flex;flex-direction:column;gap:.45rem;font-size:.84rem;color:var(--text-body);}
.tl-points li{display:flex;align-items:flex-start;gap:.5rem;line-height:1.6;}
