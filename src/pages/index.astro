@media(max-width:960px){.hero{grid-template-columns:1fr;gap:2.5rem;}h1.hero-title{font-size:2.3rem;}.nav-links{display:none;}.sec-title{font-size:1.8rem;}.award-card{grid-template-columns:1fr;gap:1.5rem;}.profile-card{padding:2rem;}}
