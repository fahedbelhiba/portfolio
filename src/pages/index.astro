---
import Layout from '../layouts/Layout.astro';

const projects = [
  { id:"vehicle-ble-companion", badge:"Android BLE · Vehicle Companion", badgeClass:"badge-connected", year:"2024–2026", category:"android ble mobility", titleEn:"Vehicle BLE Companion App & Scanner", titleFr:"Application Compagnon Véhicule & Scanner BLE", summaryEn:"Native Android Kotlin app for real-time vehicle telemetry and remote control via Bluetooth Low Energy GATT.", summaryFr:"Application Android Kotlin pour le contrôle distant et la télémétrie en temps réel via BLE GATT.", pointsEn:["Hands-free welcome zone: RSSI threshold (-65 dBm) auto-unlock.","Live GATT telemetry: Battery SoC%, range km, cabin temperature.","Remote commands: Door lock/unlock & climate pre-conditioning."], pointsFr:["Zone mains-libres : seuil RSSI calibré (-65 dBm) avec déverrouillage.","Télémétrie GATT : SoC%, autonomie, température habitacle.","Commandes distantes encodées : verrouillage et pré-conditionnement."], tech:["Kotlin","Android BLE","GATT Client","MVVM","StateFlow","Coroutines","Git"], github:"https://github.com/fahedbelhiba/vehicle-ble-companion" },
  { id:"driver-id-profile-sync", badge:"Offline-First · Cloud Sync", badgeClass:"badge-mobility", year:"2024–2026", category:"mobility ble", titleEn:"Driver Profile & Cloud Sync Service", titleFr:"Profil Conducteur & Synchronisation Cloud", summaryEn:"Autonomous in-cabin driver identification and real-time sync of vehicle preferences across vehicles.", summaryFr:"Reconnaissance automatique du conducteur et adaptation instantanée des réglages personnalisés.", pointsEn:["Offline-First: high-speed Room cache for zero-latency adjustments.","Secure async GCP/NoSQL replication for cross-vehicle portability.","Smart conflict resolution: local-wins strategy."], pointsFr:["Offline-First : cache Room ultra-rapide pour adaptation immédiate.","Réplication sécurisée vers cloud NoSQL (GCP).","Résolution intelligente de conflits locaux/distants."], tech:["Kotlin","Room DB","WorkManager","GCP Firestore","Offline-First","MVVM","Git"], github:"https://github.com/fahedbelhiba/driver-id-profile-sync" },
  { id:"vehicle-wifi-direct-link", badge:"Wi-Fi Direct P2P · Diagnostics", badgeClass:"badge-connected", year:"2024–2026", category:"android ble", titleEn:"In-Vehicle Wi-Fi Direct P2P Link", titleFr:"Liaison Locale Wi-Fi Direct P2P pour Véhicule", summaryEn:"High-speed P2P channel between smartphone and in-vehicle head unit for diagnostics and data transfer.", summaryFr:"Canal haut débit entre smartphone et système embarqué pour diagnostic et transfert de données.", pointsEn:["WifiP2pManager: autonomous P2P group negotiation and peer discovery.","Bidirectional TCP socket with length-prefix framing for diagnostics.","Continuous link health monitoring and automated reconnection."], pointsFr:["WifiP2pManager pour la négociation de groupe P2P autonome.","Sockets TCP/UDP bidirectionnel pour diagnostics embarqués.","Surveillance continue de liaison et reconnexion automatique."], tech:["Android SDK","WifiP2pManager","TCP Sockets","Kotlin","Coroutines","Git"], github:"https://github.com/fahedbelhiba/vehicle-wifi-direct-link" },
  { id:"budget-manager-kotlin", badge:"Mobile Android · Kotlin", badgeClass:"badge-android", year:"2022–2024", category:"android", titleEn:"Personal Budget Management App", titleFr:"Application mobile de gestion de budget personnel", summaryEn:"Android personal finance app in Kotlin to track expenses, visualize balance and manage transaction history.", summaryFr:"Application Android Kotlin pour le suivi des dépenses/revenus et la gestion budgétaire.", pointsEn:["Categorized transaction logging (Transport, Housing, Utilities).","Room DB + StateFlow for live balance analytics and history.","MPAndroidChart, Hilt DI, dark mode, recurring transactions."], pointsFr:["Catégorisation des transactions (Transport, Logement, Services).","Room DB + StateFlow, calcul de solde en direct.","MPAndroidChart, injection Hilt, mode sombre, transactions récurrentes."], tech:["Kotlin","Room DB","Hilt","StateFlow","MPAndroidChart","Android Studio","Git"], github:"https://github.com/fahedbelhiba/budget-manager-kotlin" },
  { id:"carpooling-platform-java", badge:"Java · Spring Boot · SQL", badgeClass:"badge-mobility", year:"2022–2024", category:"mobility", titleEn:"Java Carpooling Platform", titleFr:"Plateforme de covoiturage Java", summaryEn:"End-to-end carpooling platform for publishing, searching and booking shared eco-friendly trips.", summaryFr:"Application complète Java pour publier, rechercher et réserver des trajets partagés.", pointsEn:["Full Spring Boot REST API: roles, trip scheduling, reservations, history.","Transactional SQL (ACID), optimistic locking for concurrent booking.","JWT auth, driver ratings, admin dashboard, Docker Compose."], pointsFr:["API REST Spring Boot complète : rôles, trajets, réservations, historique.","SQL ACID avec verrouillage optimiste anti-surbooking.","JWT, évaluations conducteurs, dashboard admin, Docker Compose."], tech:["Java 17","Spring Boot","JPA/Hibernate","SQL","JWT","Docker","Git"], github:"https://github.com/fahedbelhiba/carpooling-platform-java" },
  { id:"service-booking-app", badge:"Mobile Android · Kotlin", badgeClass:"badge-android", year:"2024–2026", category:"android", titleEn:"Service Booking & Management App", titleFr:"Application mobile de réservation de services", summaryEn:"Native Android Kotlin app to search, browse availability and book on-demand services in real time.", summaryFr:"Application Android Kotlin pour rechercher et réserver des services en temps réel.", pointsEn:["Multicriteria discovery with live calendar slots and instant booking.","FCM push notifications + offline queue for bookings without network.","Jetpack Compose UI, Coroutines + Flow, Retrofit, review system."], pointsFr:["Recherche multicritère et réservation instantanée avec créneaux en direct.","Notifications FCM et file d'attente hors ligne.","UI Jetpack Compose, Coroutines + Flow, client Retrofit."], tech:["Kotlin","Jetpack Compose","Retrofit","FCM","MVVM","Coroutines","Git"], github:"https://github.com/fahedbelhiba/service-booking-app" },
  { id:"esp32-pulse-ble", badge:"ESP32 · BLE · IoT", badgeClass:"badge-iot", year:"2024–2026", category:"iot ble", titleEn:"ESP32 Pulse Sensor & BLE Heart Rate", titleFr:"Capteur Pouls ESP32 & Fréquence Cardiaque BLE", summaryEn:"ESP32 firmware reading MAX30102 pulse sensor and advertising real-time BPM and SpO2 via BLE GATT Heart Rate Service.", summaryFr:"Firmware ESP32 lisant le capteur MAX30102 et diffusant BPM et SpO2 en temps réel via BLE GATT.", pointsEn:["MAX30102 I2C driver at 100Hz + Pan-Tompkins BPM algorithm.","BLE GATT Heart Rate Service (0x180D) with CCCD notifications every 1s.","OLED display, RGB LED, FreeRTOS tasks, OTA update support."], pointsFr:["Driver MAX30102 I2C à 100Hz + algorithme Pan-Tompkins.","Service BLE GATT Heart Rate (0x180D) avec notifications CCCD toutes les secondes.","Affichage OLED, LED RGB, FreeRTOS, mise à jour OTA."], tech:["ESP32","C++/Arduino","MAX30102","BLE GATT","FreeRTOS","PlatformIO","Git"], github:"https://github.com/fahedbelhiba/esp32-pulse-ble" },
  { id:"android-health-monitor", badge:"Android · BLE · Health", badgeClass:"badge-android", year:"2024–2026", category:"android ble iot", titleEn:"Android Health Monitor — BLE & ESP32", titleFr:"Moniteur de Santé Android — BLE & ESP32", summaryEn:"Android Kotlin app receiving real-time BPM and SpO2 from ESP32 BLE pulse sensor with live charts and session history.", summaryFr:"Application Android Kotlin recevant BPM et SpO2 en temps réel depuis l'ESP32 BLE avec graphiques et historique.", pointsEn:["GATT subscription to Heart Rate (0x180D) + SpO2 custom characteristic.","Live animated BPM gauge + MPAndroidChart sparkline, color-coded zones.","Room DB session history, CSV export, Hilt DI, Jetpack Compose UI."], pointsFr:["Souscription GATT Heart Rate (0x180D) + caractéristique SpO2 personnalisée.","Jauge BPM animée + graphique MPAndroidChart, zones colorées.","Historique Room DB, export CSV, Hilt DI, UI Jetpack Compose."], tech:["Kotlin","Android BLE","GATT","MPAndroidChart","Room DB","Hilt","Git"], github:"https://github.com/fahedbelhiba/android-health-monitor" },
  { id:"smart-parking-iot", badge:"ESP32 · MQTT · IoT", badgeClass:"badge-iot", year:"2024–2026", category:"iot", titleEn:"Smart Parking IoT Sensor", titleFr:"Capteur IoT de Stationnement Intelligent", summaryEn:"ESP32 with HC-SR04 ultrasonic sensor detecting parking spot occupancy and reporting FREE/OCCUPIED via MQTT over Wi-Fi.", summaryFr:"ESP32 avec capteur HC-SR04 détectant l'occupation d'une place de parking et publiant via MQTT.", pointsEn:["HC-SR04 ultrasonic ranging + 3-reading debounce for FREE/OCCUPIED detection.","MQTT QoS 1 publish to broker with JSON payload and retain flag.","Multi-slot (4 sensors), LED indicator, OTA update, Python SQLite subscriber."], pointsFr:["HC-SR04 + anti-rebond 3 lectures pour détection FREE/OCCUPIED.","Publication MQTT QoS 1 avec payload JSON et flag retain.","Multi-capteur (4 slots), LED indicateur, OTA, subscriber Python SQLite."], tech:["ESP32","C++/Arduino","HC-SR04","MQTT","Python","PlatformIO","Git"], github:"https://github.com/fahedbelhiba/smart-parking-iot" },
  { id:"eco-driving-score", badge:"Android · GPS · Sensors", badgeClass:"badge-mobility", year:"2024–2026", category:"android mobility", titleEn:"Eco-Driving Score App", titleFr:"Application Score Éco-Conduite", summaryEn:"Android Kotlin app using accelerometer and GPS to detect harsh braking, acceleration and cornering, computing an eco-driving score.", summaryFr:"Application Android Kotlin utilisant l'accéléromètre et le GPS pour scorer le comportement de conduite.", pointsEn:["G-force event detection: braking (>0.4g), acceleration (>0.35g), cornering.","GPS-correlated trip recording with foreground service + Room DB storage.","Score algorithm, CO2 savings estimate, weekly trends, PDF export."], pointsFr:["Détection d'événements G: freinage (>0.4g), accélération, virages.","Enregistrement de trajet GPS avec service foreground + stockage Room DB.","Algorithme de score, estimation CO2, tendances hebdomadaires, export PDF."], tech:["Kotlin","Android Sensors","GPS","Room DB","MVVM","Hilt","Git"], github:"https://github.com/fahedbelhiba/eco-driving-score" },
  { id:"iot-firebase-logger", badge:"ESP32 · Firebase · IoT", badgeClass:"badge-iot", year:"2024–2026", category:"iot android", titleEn:"IoT Multi-Sensor Firebase Logger", titleFr:"Logger IoT Multi-Capteurs Firebase", summaryEn:"ESP32 pushing DHT22 temperature, humidity and MAX30102 pulse data to Firebase Realtime DB with Android live monitoring.", summaryFr:"ESP32 envoyant données DHT22 et MAX30102 vers Firebase Realtime DB avec monitoring Android en direct.", pointsEn:["DHT22 + MAX30102 sensors pushed to Firebase every 30s with NTP timestamp.","SD card offline backup + auto-sync to Firebase on reconnect.","Android app with live charts, alerts, 7-day history and multi-node support."], pointsFr:["DHT22 + MAX30102 envoyés vers Firebase toutes les 30s avec horodatage NTP.","Backup SD hors-ligne + synchronisation automatique à la reconnexion.","App Android avec graphiques live, alertes, historique 7j et multi-nœuds."], tech:["ESP32","Firebase","DHT22","MAX30102","Kotlin","Android","Git"], github:"https://github.com/fahedbelhiba/iot-firebase-logger" },
  { id:"vehicle-can-dashboard", badge:"Android · OBD-II · CAN", badgeClass:"badge-mobility", year:"2024–2026", category:"android mobility", titleEn:"Vehicle OBD-II & CAN Bus Dashboard", titleFr:"Dashboard OBD-II & CAN Bus Véhicule", summaryEn:"Android Kotlin real-time vehicle diagnostics dashboard via Bluetooth ELM327: RPM, speed, coolant, DTC fault codes.", summaryFr:"Dashboard Android Kotlin de diagnostic véhicule via ELM327 Bluetooth : RPM, vitesse, température, codes DTC.", pointsEn:["ELM327 Bluetooth RFCOMM + OBD-II PIDs: RPM, speed, coolant, throttle, fuel.","Animated gauges: RPM arc + speedometer needle + DTC read/clear.","Trip logging to Room DB, session playback, fuel consumption estimate."], pointsFr:["ELM327 Bluetooth RFCOMM + PIDs OBD-II : RPM, vitesse, coolant, carburant.","Jauges animées : arc RPM + aiguille vitesse + lecture/effacement DTC.","Enregistrement Room DB, replay de session, estimation consommation."], tech:["Kotlin","Bluetooth","OBD-II","ELM327","Room DB","MVVM","Git"], github:"https://github.com/fahedbelhiba/vehicle-can-dashboard" },
  { id:"mqtt-iot-gateway", badge:"ESP32 · MQTT · Python", badgeClass:"badge-iot", year:"2024–2026", category:"iot android", titleEn:"MQTT IoT Gateway — ESP32 + Python + Android", titleFr:"Passerelle IoT MQTT — ESP32 + Python + Android", summaryEn:"ESP32 MQTT IoT gateway bridging DHT22, BMP280 and pulse sensors to cloud broker with Python analytics and Android monitoring.", summaryFr:"Passerelle IoT ESP32 connectant capteurs DHT22, BMP280 et pouls au cloud MQTT avec analytics Python et monitoring Android.", pointsEn:["Multi-sensor MQTT publish with TLS to HiveMQ, relay control via cmd topic.","Python subscriber storing to InfluxDB + Grafana live dashboard + anomaly alerts.","Android Paho MQTT client with live cards, relay toggle and push notifications."], pointsFr:["Publication MQTT multi-capteurs TLS vers HiveMQ, contrôle relais via topic cmd.","Subscriber Python vers InfluxDB + dashboard Grafana + alertes d'anomalies.","Client Android Paho MQTT avec cartes live, toggle relais et notifications push."], tech:["ESP32","MQTT","Python","InfluxDB","Kotlin","Android","Git"], github:"https://github.com/fahedbelhiba/mqtt-iot-gateway" }
];

