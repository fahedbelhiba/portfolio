.profile-card{background:linear-gradient(145deg,rgba(13,19,33,0.95),rgba(10,14,26,0.98));border:1px solid var(--border-cyan);border-radius:24px;padding:3rem;position:relative;overflow:hidden;box-shadow:0 0 50px rgba(14,165,233,.1);}
