.modalities-bar{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;background:rgba(14,165,233,.06);border:1px solid rgba(14,165,233,.2);border-radius:14px;padding:1.25rem 1.5rem;margin-bottom:2.25rem;}
