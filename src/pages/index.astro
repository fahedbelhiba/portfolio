---
<Layout title="Fahd BELHIBA | Android Developer & Connected Mobility">
<style>
:root{--bg:#060810;--bg-surface:rgba(13,19,33,0.9);--border:rgba(255,255,255,0.08);--border-cyan:rgba(56,189,248,0.3);--cyan:#0EA5E9;--cyan-dark:#0284C7;--blue:#2563EB;--violet:#7C3AED;--emerald:#10B981;--amber:#F59E0B;--text:#F1F5F9;--text-body:#CBD5E1;--text-muted:#94A3B8;--text-dim:#64748B;--font:'Plus Jakarta Sans',-apple-system,sans-serif;--mono:'JetBrains Mono',monospace;--display:'Space Grotesk',sans-serif;}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text-body);font-family:var(--font);overflow-x:hidden;background-image:radial-gradient(ellipse at 15% 10%,rgba(14,165,233,.12) 0%,transparent 50%),radial-gradient(ellipse at 85% 80%,rgba(124,58,237,.1) 0%,transparent 50%);background-attachment:fixed;}
body::before{content:"";position:fixed;inset:0;background-image:linear-gradient(to right,rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.015) 1px,transparent 1px);background-size:60px 60px;pointer-events:none;z-index:0;}
.container{max-width:1180px;margin:0 auto;padding:0 1.5rem;position:relative;z-index:1;}
header{position:sticky;top:0;z-index:100;background:rgba(6,8,16,.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:.9rem 0;}
.nav-inner{display:flex;justify-content:space-between;align-items:center;}
.nav-logo{display:flex;align-items:center;gap:.7rem;text-decoration:none;font-weight:800;font-size:1.2rem;color:var(--text);font-family:var(--display);}
.nav-badge{font-size:.7rem;font-family:var(--mono);color:var(--cyan);background:rgba(14,165,233,.15);border:1px solid rgba(14,165,233,.3);padding:.2rem .55rem;border-radius:9999px;font-weight:700;}
.nav-links{display:flex;gap:1.5rem;list-style:none;align-items:center;}
.nav-links a{color:var(--text-muted);text-decoration:none;font-size:.85rem;font-weight:600;transition:color .2s;}
.nav-links a:hover{color:var(--cyan);}
.nav-controls{display:flex;align-items:center;gap:.75rem;}
.btn-cv{background:linear-gradient(135deg,var(--cyan-dark),var(--blue));color:#fff;padding:.45rem 1rem;border-radius:8px;font-weight:700;font-size:.82rem;display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;transition:all .2s;box-shadow:0 4px 15px rgba(2,132,199,.4);}
.btn-cv:hover{transform:translateY(-1px);box-shadow:0 8px 25px rgba(2,132,199,.5);}
.lang-btn{background:rgba(255,255,255,.06);border:1px solid var(--border);color:var(--text-muted);font-family:var(--mono);font-size:.75rem;font-weight:700;padding:.38rem .7rem;border-radius:7px;cursor:pointer;transition:all .2s;}
.lang-btn:hover{border-color:var(--cyan);color:var(--cyan);}
body.lang-en .fr{display:none!important;}
body.lang-fr .en{display:none!important;}
.hero{padding:5rem 0 4rem;display:grid;grid-template-columns:1.2fr 0.8fr;gap:3.5rem;align-items:center;}
.badge-open{display:inline-flex;align-items:center;gap:.55rem;padding:.38rem 1rem;border-radius:9999px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.3);font-size:.73rem;font-weight:700;letter-spacing:.06em;color:#34D399;margin-bottom:1.4rem;font-family:var(--mono);text-transform:uppercase;}
.pulse{width:7px;height:7px;border-radius:50%;background:#34D399;box-shadow:0 0 10px #34D399;animation:pulse 2s infinite;flex-shrink:0;}
@keyframes pulse{0%{transform:scale(.95);box-shadow:0 0 0 0 rgba(52,211,153,.7);}70%{transform:scale(1);box-shadow:0 0 0 7px rgba(52,211,153,0);}100%{transform:scale(.95);box-shadow:0 0 0 0 rgba(52,211,153,0);}}
h1.hero-title{font-size:3rem;font-weight:800;line-height:1.1;letter-spacing:-.03em;color:var(--text);margin-bottom:1rem;font-family:var(--display);}
.grad{background:linear-gradient(135deg,#38BDF8 0%,#818CF8 50%,#A78BFA 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-sub{font-size:1.05rem;font-weight:600;color:var(--text-body);margin-bottom:1rem;}
.hero-sub strong{color:var(--cyan);}
.hero-bio{font-size:.95rem;color:var(--text-muted);line-height:1.8;margin-bottom:1.8rem;}
.meta-pills{display:flex;flex-wrap:wrap;gap:.7rem;margin-bottom:2rem;}
.meta-pill{display:flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.05);border:1px solid var(--border);padding:.35rem .8rem;border-radius:8px;font-size:.8rem;color:var(--text-body);font-family:var(--mono);}
.meta-pill a{color:inherit;text-decoration:none;font-weight:600;}
.meta-pill a:hover{color:var(--cyan);}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap;}
.btn{display:inline-flex;align-items:center;gap:.5rem;font-size:.9rem;font-weight:700;padding:.85rem 1.5rem;border-radius:10px;text-decoration:none;transition:all .25s;cursor:pointer;border:none;}
.btn-primary{background:linear-gradient(135deg,var(--cyan-dark),var(--blue));color:#fff;box-shadow:0 4px 20px rgba(2,132,199,.4);}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(2,132,199,.6);}
.btn-secondary{background:rgba(255,255,255,.06);color:var(--text);border:1px solid var(--border);}
.btn-secondary:hover{background:rgba(255,255,255,.1);border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px);}
.hud-card{background:linear-gradient(145deg,rgba(13,19,33,.95),rgba(6,8,22,.98));border:1px solid var(--border-cyan);border-radius:20px;padding:1.75rem;position:relative;overflow:hidden;box-shadow:0 0 40px rgba(14,165,233,.1);}
.hud-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--cyan),#818CF8,var(--cyan));}
.hud-top{display:flex;justify-content:space-between;align-items:center;padding-bottom:.9rem;border-bottom:1px solid var(--border);margin-bottom:1.2rem;}
.hud-title{font-family:var(--mono);font-size:.73rem;font-weight:700;color:var(--cyan);text-transform:uppercase;letter-spacing:.1em;display:flex;align-items:center;gap:.5rem;}
.status-badge{display:flex;align-items:center;gap:.4rem;font-family:var(--mono);font-size:.68rem;font-weight:700;background:rgba(16,185,129,.15);color:#34D399;padding:.2rem .6rem;border-radius:6px;border:1px solid rgba(16,185,129,.3);}
.gauges{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-bottom:1.1rem;}
.gauge{background:rgba(6,8,16,.6);border:1px solid var(--border);border-radius:12px;padding:1rem .8rem;text-align:center;}
