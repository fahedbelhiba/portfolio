.badge-mobility{background:rgba(124,58,237,.15);color:#A78BFA;border:1px solid rgba(124,58,237,.3);}
.badge-connected{background:rgba(16,185,129,.15);color:#34D399;border:1px solid rgba(16,185,129,.3);}
.badge-iot{background:rgba(251,146,60,.15);color:#FB923C;border:1px solid rgba(251,146,60,.3);}
.badge-medal{background:rgba(245,158,11,.15);color:#FBBF24;border:1px solid rgba(245,158,11,.35);font-weight:800;}
